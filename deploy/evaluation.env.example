# Non-secret example only. Never source this in the public Render service.
# Every real run requires fresh explicit owner authorization.
# Configure BASETEN_API_KEY through the protected runtime, never in this file.
FORGE_INFERENCE_PROVIDER=baseten
FORGE_INFERENCE_ENDPOINT=https://inference.baseten.co/v1/chat/completions
FORGE_INFERENCE_MODEL_ID=meta-models/muse-spark-open-1026
FORGE_INFERENCE_ENABLED=false
FORGE_INFERENCE_FREE_ACCESS_CONFIRMED=false
FORGE_INFERENCE_REQUEST_BUDGET=5
FORGE_INFERENCE_RETRY_LIMIT=0
FORGE_INFERENCE_TOKEN_BUDGET=81920
FORGE_INFERENCE_MAX_TOKENS=1024
FORGE_INFERENCE_TIMEOUT_SECONDS=15
FORGE_INFERENCE_TOTAL_TIMEOUT_SECONDS=30
FORGE_INFERENCE_THERMAL_IMAGES=false
# Set securely to a real private 0600 smoke receipt only after successful smoke:
# FORGE_INFERENCE_VALIDATED_SMOKE_PATH=/private/path/event-smoke-01.json
FORGE_SMOKE_CREDITS_APPROVED=false
FORGE_SMOKE_CARD_FREE_ENTITLEMENT_CONFIRMED=false
FORGE_EVALUATION_OWNER_AUTHORIZED=false
FORGE_EVALUATION_NATIVE_THERMAL_AUTHORIZED=false

# Confirm enforced Model API stopping behavior; notification-only alerts are insufficient.
FORGE_SMOKE_PROVIDER_SPENDING_LIMIT_CONFIRMED=false
