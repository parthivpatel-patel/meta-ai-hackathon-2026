# Docker --env-file format; do not shell-source this JSON list.
# Replace/add the exact verified public hostname before HTTPS deployment.
FORGE_DEMO_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
FORGE_DEMO_MODE=public
FORGE_DEMO_DB_PATH=/data/investigations.sqlite3
FORGE_PROVIDER=mock
FORGE_INFERENCE_ENABLED=false
FORGE_INFERENCE_REQUEST_BUDGET=0
PORT=7860
# Never add inference or owner credentials to the public service.
